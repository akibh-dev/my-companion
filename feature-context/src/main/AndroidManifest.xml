<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sound mode and Do Not Disturb (FR-3.3). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Saved places and the Wi-Fi network name (FR-3.1, FR-3.10). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Bluetooth device connected" trigger (FR-3.7). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Brightness action (FR-3.8). Granted in system settings. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />
    <!-- Keep screen on outdoors (FR-3.5): an invisible overlay window with FLAG_KEEP_SCREEN_ON. -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <application>
        <receiver
            android:name=".device.ProximityReceiver"
            android:exported="false" />
    </application>
</manifest>
