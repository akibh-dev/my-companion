<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The capture panel: a dimmed, see-through window, so you still see what you were doing. -->
    <style name="Theme.Capture.Panel" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
    </style>
</resources>
