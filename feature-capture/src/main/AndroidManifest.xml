<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice notes (FR-4.2): recorded only while you tap Record, in a microphone foreground service. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No CAMERA permission on purpose: photos are taken by the camera app (TakePicture). Declaring it
         would make the camera intent fail until it's granted. -->

    <queries>
        <!-- Lets the permissions screen check that a camera app exists. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application>
        <!-- The see-through capture panel (FR-4.2); shows over the lock screen for new captures (FR-4.8).
             Exported so the home-screen widget's CAPTURE action reaches it. -->
        <activity
            android:name=".ui.CapturePanelActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Quick capture"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Capture.Panel"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.akib.mycompanion.action.CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Both volume keys held for a second open the panel (FR-4.1); also takes screenshots (FR-4.7). -->
        <service
            android:name=".system.CaptureAccessibilityService"
            android:exported="true"
            android:label="@string/capture_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/capture_accessibility" />
        </service>

        <!-- Records voice notes; type microphone (FR-4.2). -->
        <service
            android:name=".system.CaptureRecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Quick Settings: open the capture panel. -->
        <service
            android:name=".system.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_capture"
            android:label="Quick capture"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Gives the camera app a one-off write grant for the photo it's taking (filesDir/captures). -->
        <provider
            android:name=".data.CaptureFileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>
    </application>
</manifest>
