<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- App names for spoken notifications and the voice mode app picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- Reads notifications for auto-reply (chat apps) and voice mode (any app) (FR-1, FR-5). The system starts it
             once "Notification access" is switched on for the app. -->
        <service
            android:name=".MessageListener"
            android:exported="true"
            android:label="My Companion messages"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
