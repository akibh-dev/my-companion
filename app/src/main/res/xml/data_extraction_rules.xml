<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="companion.db" />
        <!-- Recent writes sit in the write-ahead log until a checkpoint; without it a restore loses them.
             The -shm index is rebuilt from the log, so it is left out. -->
        <include domain="database" path="companion.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="companion.db" />
        <!-- Recent writes sit in the write-ahead log until a checkpoint; without it a restore loses them.
             The -shm index is rebuilt from the log, so it is left out. -->
        <include domain="database" path="companion.db-wal" />
    </device-transfer>
</data-extraction-rules>
