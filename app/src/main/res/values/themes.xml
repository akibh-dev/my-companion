<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyCompanion" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7F7F7</item>
        <!-- Launch animation: Buddy on its black icon circle, then MainActivity fades it out. -->
        <item name="android:windowSplashScreenBackground">#F7F7F7</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_buddy</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_background</item>
    </style>

    <!-- See-through activities: call shortcuts and the share sheet. -->
    <style name="Theme.MyCompanion.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoDisplay">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Translucent themes don't draw system-bar backgrounds, which left the bars black (and the
             dark clock invisible). Draw them, transparent, so the app behind shows through. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
