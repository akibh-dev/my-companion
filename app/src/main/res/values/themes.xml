<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyCompanion" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- See-through activities: call shortcuts and the share sheet. -->
    <style name="Theme.MyCompanion.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoDisplay">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Translucent themes don't draw system-bar backgrounds, which left the bars black (and the
             dark clock invisible). Draw them, transparent, so the app behind shows through. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
