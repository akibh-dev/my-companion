<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+: adaptive, so launchers shape it like other icons instead of putting it in a white circle.
     Android 7.x uses drawable/ic_shortcut_call.xml. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground android:drawable="@drawable/ic_shortcut_call_foreground" />
    <monochrome android:drawable="@drawable/ic_shortcut_call_foreground" />
</adaptive-icon>
